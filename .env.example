# Local AWS / LocalStack — copy to .env and adjust if needed.
# The FastAPI apps do NOT read these today (they use Redis). Keep this file
# for Terraform CLI, awslocal, and future AWS SDK wiring.

# Force LocalStack (never omit when using AWS CLI against this project)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true

# From another Compose service on the same network:
# AWS_ENDPOINT_URL=http://localstack:4566
#
# From a Minikube pod to LocalStack on the Docker Desktop host:
# AWS_ENDPOINT_URL=http://host.docker.internal:4566
